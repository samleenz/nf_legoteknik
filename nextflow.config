apptainer.enabled       = true
report.overwrite        = true


// parameters
params {
    // set for each run
    // outputDir      = '/data/Analysis/Lab_TPH/scrnaseq_legotek/TPH_SGRESIST_L002'
    // bcl_dir      = '/data/Analysis/Lab_TPH/datasets_raw/TPH_SGRESIST_L002'
    // run_manifest = 'data/example_run_manifest.csv'
    // sampletable  = 'data/example_sampletable.csv'

    // input paths for making bclconvert samplsheets
    single_template = 'data/bcl_samplesheet_templates/bclconvert_single_template.txt'
    dual_template   = 'data/bcl_samplesheet_templates/bclconvert_dual_template.txt'
    single_index    = 'data/truseq_i7_indexes.json'
    dual_index      = 'data/chromium_10X_indexes.json'
    feature_index_type = 'single'
    gex_index_type     = 'dual'

    // input path for making library csv files
    library_template = 'data/library_template.csv'



    // apptainer containers
    container_bclconvert    = 'file:///data/containers/lee_s/nfcore_bclconvert_4.0.3.sif' 
    container_cellranger    = 'file:///data/containers/lee_s/cellranger_bcl2fastq.sif' 
    container_r             = 'file:///data/containers/lee_s/rocker_tidyverse_4.3.1.sif'
    container_multiqc       = 'file:///data/containers/lee_s/multiqc_v1.26.sif'

    // cellranger parameters
    transcriptome = '/data/Analysis/Lab_TPH/references/10X/GRCh38/refdata-gex-GRCh38-2024-A'
    feature_reference   = 'data/feature_reference_simple.csv'
    // feature_reference   = 'data/feature_reference.csv'


}
